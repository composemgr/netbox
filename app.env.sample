# netbox - app.env.sample
# Copy to app.env and adjust values before starting the stack.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# Admin credentials
APP_ADMIN_USER=administrator
APP_ADMIN_PASS=changeme_admin_password
APP_ADMIN_EMAIL=admin@example.com

# API token (min 40 chars)
APP_API_TOKEN=changeme_api_token_min_40_chars

# Secret key (min 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Database credentials
DB_USER_NAME=netbox
DB_USER_PASS=changeme_db_password
DB_CREATE_DATABASE_NAME=netbox
